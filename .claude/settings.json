{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(node scripts/*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git push)",
      "Bash(git stash*)",
      "Bash(git branch*)",
      "Bash(find . *)",
      "Bash(grep -r *)",
      "Bash(grep -n *)",
      "Bash(ls *)",
      "Bash(wc -l *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'INPUT=$(cat); if echo \"$INPUT\" | grep -q \"brand-tokens.json\"; then cd /home/kingofyadav/dev/projects/Profile && npm run build:tokens 2>&1 && echo \"[tokens] css/brand-tokens.css regenerated\"; fi'"
          }
        ]
      }
    ]
  }
}
