{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Single source of truth for brand design tokens — kingofyadav.in",
  "version": "1.0.0",
  "colors": {
    "brand-green":       "#046A38",
    "brand-green-deep":  "#034f2a",
    "brand-green-soft":  "rgba(4,106,56,0.15)",
    "brand-orange":      "#FF671F",
    "brand-orange-deep": "#e55a16",
    "brand-orange-soft": "rgba(255,103,31,0.15)"
  },
  "shadows": {
    "brand-green": "0 4px 20px rgba(4,106,56,0.28)",
    "brand-orange": "0 4px 20px rgba(255,103,31,0.28)"
  },
  "gradients": {
    "brand-primary": "linear-gradient(135deg, #046A38, #FF671F)",
    "brand-mesh": "radial-gradient(circle at 20% 30%, rgba(4,106,56,0.15), transparent 50%), radial-gradient(circle at 80% 70%, rgba(255,103,31,0.15), transparent 50%)"
  },
  "streamlit": {
    "primary_color": "#046A38",
    "secondary_background_color": "#0a2e1a"
  }
}
